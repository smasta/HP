# ------------------------------------------------------------------
# お問い合わせフォームの送信設定
# .env.local にコピーして値を入れる（.env.local はコミットしない）
# ------------------------------------------------------------------

# 受信先。未設定なら oxy@smasta.co.jp
CONTACT_TO_EMAIL=oxy@smasta.co.jp

# 差出人。SMTPサーバーが許可しているアドレスにする
CONTACT_FROM_EMAIL=no-reply@smasta.co.jp

# SMTPサーバー（この3つが揃っていないと送信されない）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
